# ─────────────────────────────────────────────────────────────────────────
# GeoAlerta API — configuração de ambiente
#
# Copie este arquivo para `.env` (no diretório backend/) e ajuste os valores.
# O `.env` NÃO é versionado. As variáveis também podem ser definidas como
# variáveis de ambiente reais ou via -Dchave=valor (que têm precedência).
# ─────────────────────────────────────────────────────────────────────────

# String de conexão JDBC com o PostgreSQL
GEOALERTA_DB_URL=jdbc:postgresql://localhost:5432/postgres

# Usuário e senha do banco
GEOALERTA_DB_USER=postgres
GEOALERTA_DB_PASSWORD=postgres

# ─────────────────────────────────────────────────────────────────────────
# Exemplo para o banco do Supabase (descomente e ajuste <REF> e a senha).
# Use a porta 5432 (conexão direta) ou 6543 (pooler), conforme o painel.
#
# GEOALERTA_DB_URL=jdbc:postgresql://db.<REF>.supabase.co:5432/postgres
# GEOALERTA_DB_USER=postgres
# GEOALERTA_DB_PASSWORD=sua-senha-do-supabase
# ─────────────────────────────────────────────────────────────────────────

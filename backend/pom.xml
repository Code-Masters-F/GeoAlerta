<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.geoalerta</groupId>
    <artifactId>geoalerta-api</artifactId>
    <version>1.0.0</version>
    <packaging>war</packaging>

    <name>GeoAlerta API</name>
    <description>API RESTful (Servlets + DAO + PostgreSQL) para a plataforma GeoAlerta</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>

        <servlet.api.version>6.0.0</servlet.api.version>
        <postgresql.version>42.7.4</postgresql.version>
        <gson.version>2.11.0</gson.version>
    </properties>

    <dependencies>
        <!-- API de Servlets (Jakarta EE 10 / Tomcat 10.1+). Fornecida pelo container. -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>${servlet.api.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Driver JDBC do PostgreSQL (camada Repository/DAO). -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
        </dependency>

        <!-- Serializacao JSON (entrada/saida dos controllers). -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>geoalerta-api</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
            </plugin>

            <!--
              Executa um Tomcat 10.1 embarcado para desenvolvimento:
                  mvn cargo:run
              (baixa o Tomcat na primeira execucao; requer acesso a internet).
              Para producao, basta gerar o WAR com `mvn package` e copia-lo
              para a pasta webapps/ de um Tomcat 10.1+.
            -->
            <plugin>
                <groupId>org.codehaus.cargo</groupId>
                <artifactId>cargo-maven3-plugin</artifactId>
                <version>1.10.15</version>
                <configuration>
                    <container>
                        <containerId>tomcat10x</containerId>
                        <artifactInstaller>
                            <groupId>org.apache.tomcat</groupId>
                            <artifactId>tomcat</artifactId>
                            <version>10.1.31</version>
                        </artifactInstaller>
                    </container>
                    <configuration>
                        <properties>
                            <cargo.servlet.port>8080</cargo.servlet.port>
                        </properties>
                    </configuration>
                    <deployables>
                        <deployable>
                            <groupId>com.geoalerta</groupId>
                            <artifactId>geoalerta-api</artifactId>
                            <type>war</type>
                            <properties>
                                <context>geoalerta-api</context>
                            </properties>
                        </deployable>
                    </deployables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
